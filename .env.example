# ---- Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Comma-separated origins allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL
# postgres://<user>:<password>@<host>:<port>/<database>  (URL-encode special characters in the password)
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/emqube_pms
DB_POOL_MAX=10
DB_SSL=false

# ---- Auth (use long random values: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=15m
COOKIE_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING_32_CHARS
# Refresh-token lifetime in days ("Keep me signed in" off / on)
REFRESH_TTL_DAYS=1
REFRESH_TTL_REMEMBER_DAYS=30
# Account is locked after this many wrong passwords (admin unlocks it)
MAX_FAILED_LOGINS=5
BCRYPT_ROUNDS=12

# ---- Seed (npm run db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
