{
  "name": "emqube-pms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "emQube PMS \u2013 REST API (Fastify + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "prestart": "node scripts/check-node.cjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "predb:create": "node scripts/check-node.cjs",
    "db:create": "node --env-file-if-exists=.env scripts/create-db.js",
    "predb:migrate": "node scripts/check-node.cjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "predb:seed": "node scripts/check-node.cjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "test": "node --env-file-if-exists=.env --test test/"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "env-schema": "^8.0.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
